{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "edit": "ask",
    "bash": {
      "*": "ask",
      "mvn test*": "allow",
      "mvn compile*": "allow",
      "mvn checkstyle:check*": "allow",
      "mvn clean*": "allow",
      "git status*": "allow",
      "git diff*": "allow",
      "git add*": "allow",
      "git commit*": "allow",
      "git log*": "allow",
      "git branch*": "allow",
      "git switch*": "allow",
      "git push*": "ask",
      "rm -rf*": "deny",
      "rm -r*": "deny"
    },
    "read": {
      ".env": "deny",
      "/home/jane/edu/otus/llm/timeline-project/.opencode/gsd-core/*": "allow"
    },
    "external_directory": {
      "/home/jane/edu/otus/llm/timeline-project/.opencode/gsd-core/*": "allow"
    }
  },
  "mcp": {
    "playwright": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@playwright/mcp@latest"
      ],
      "enabled": true
    },
    "gsd": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "-p",
        "@opengsd/gsd-core",
        "gsd-mcp-server",
        "--no-prompts"
      ],
      "enabled": true
    }
  }
}
